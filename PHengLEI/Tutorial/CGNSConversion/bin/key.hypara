string title     = "HyperFLOW Main Parameter Control File"
// csmode: File and Communication model: 
//    0 -- C/S (Client/Server) Model, defualt used.
//    1 -- P2P (Point to Point ) Model, advanced model used in large-scale problems.
// ndim: Dimensional of the grid: 2 or 3.
// nsimutask: simulation task type.
//    0 -- CFD Solver of NS or Turbulation.
//    1 -- Grid conversion: from other format to HyperFLOW format (.fts).
//				 Grid generation for special typical cases, such as flat plate, circle;
//    2 -- Wall distance computation for turb-solver.
//    3 -- Grid partition.
//    4 -- Knowledge repository / examples of PHengLEI-API.

