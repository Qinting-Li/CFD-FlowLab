string energyConvCalc     = "UPWIND";               
string energyDiffCalc     = "NON_ORTHOGONAL";       
string energySourceCalc[] = ["EMPTY"];              
string energyGradCalc     = "GAUSS";                
string energyTranCalc     = "IMPLICIT_EULER";       

